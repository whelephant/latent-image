---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/*
  Figure — a plain responsive <picture> (AVIF + WebP) with intrinsic dimensions
  (no layout shift). Used for essay images and series covers. No effects.
*/
interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
  priority?: boolean;
  sizes?: string;
  class?: string;
}
const { image, alt, caption, priority = false, sizes, class: cls = '' } = Astro.props;

const widths = [480, 768, 1024, 1440, 1920].filter((w) => w <= image.width);
if (widths.at(-1) !== image.width) widths.push(image.width);
---

<figure class:list={['figure', cls]}>
  <Picture
    src={image}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    widths={widths}
    sizes={sizes ?? '100vw'}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'auto' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
    class="figure__img"
  />
  {caption && <figcaption class="figure__cap">{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin-block: var(--space-l);
  }
  .figure__img {
    width: 100%;
    height: auto;
  }
  .figure__cap {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
</style>
