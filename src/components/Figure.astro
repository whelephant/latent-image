---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/*
  Figure — responsive <picture> (AVIF + WebP) with intrinsic dimensions (no CLS,
  brief §6) and the latent->developed reveal (brief §3d). Three placements:
  in-column (default), breakout (past the measure), margin (into the margin
  track), full (full-bleed).

  The LQIP is painted instantly as a blurred backdrop; the sharp image fades and
  de-blurs on load. With JS off it simply shows; under reduced-motion it appears
  already developed (no animation). LCP/hero images pass priority to skip the
  latent delay.
*/
interface Props {
  image: ImageMetadata;
  alt: string;
  lqip?: string;
  mode?: 'in-column' | 'breakout' | 'margin' | 'full';
  caption?: string;
  exif?: Record<string, string | undefined>;
  priority?: boolean;
  sizes?: string;
  /* render a <div> wrapper with no <figcaption> — for use inside interactive
     parents (e.g. a gallery <button>, where nesting <figure> would be invalid) */
  bare?: boolean;
  class?: string;
}

const {
  image,
  alt,
  lqip,
  mode = 'in-column',
  caption,
  exif,
  priority = false,
  sizes,
  bare = false,
  class: cls = '',
} = Astro.props;

const widths = [480, 768, 1024, 1440, 1920].filter((w) => w <= image.width);
if (widths.at(-1) !== image.width) widths.push(image.width);

const defaultSizes =
  mode === 'full'
    ? '100vw'
    : mode === 'margin'
      ? '(min-width: 60rem) 16rem, 100vw'
      : mode === 'breakout'
        ? '(min-width: 60rem) 58rem, calc(100vw - 3rem)'
        : 'min(65ch, calc(100vw - 3rem))';

// EXIF is data — render in the brief's fixed order, not frontmatter key order.
const EXIF_ORDER = ['camera', 'lens', 'focal', 'shutter', 'aperture', 'iso'] as const;
const exifValues = exif
  ? EXIF_ORDER.map((k) => exif[k]).filter((v): v is string => !!v)
  : [];

const Wrapper = bare ? 'div' : 'figure';
---

<Wrapper class:list={['figure', `figure--${mode}`, cls]}>
  <div
    class="figure__frame"
    style={lqip ? `background-image:url(${lqip})` : undefined}
  >
    <Picture
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={widths}
      sizes={sizes ?? defaultSizes}
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'auto' : 'async'}
      fetchpriority={priority ? 'high' : 'auto'}
      class="figure__img"
      data-develop={priority ? undefined : ''}
    />
  </div>

  {
    !bare && (caption || exifValues.length > 0) && (
      <figcaption class="figure__cap">
        {caption && <span class="figure__caption-text">{caption}</span>}
        {exifValues.length > 0 && (
          <span class="figure__exif mono">
            {exifValues.map((v) => (
              <span class="figure__exif-item">{v}</span>
            ))}
          </span>
        )}
      </figcaption>
    )
  }
</Wrapper>

<style>
  .figure {
    margin-block: var(--space-l);
  }
  .figure__frame {
    position: relative;
    overflow: hidden;
    background-color: var(--mat);
    background-size: cover;
    background-position: center;
    border-radius: var(--radius);
    line-height: 0;
  }
  .figure__img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Latent -> developed. Only engaged when JS is present (html.js); without JS
     the image shows normally. */
  :global(html.js) .figure__img[data-develop] {
    opacity: 0;
    filter: blur(14px);
    transform: scale(1.04);
    transition:
      opacity var(--dur-slow) var(--ease-out),
      filter var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
    will-change: opacity, filter;
  }
  :global(html.js) .figure__img[data-develop].is-developed {
    opacity: 1;
    filter: none;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .figure__img[data-develop] {
      opacity: 1;
      filter: none;
      transform: none;
      transition: none;
    }
  }

  /* ---- Caption / EXIF (mono — data face, brief §6) ---- */
  .figure__cap {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
    line-height: 1.4;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .figure__caption-text {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--ink);
  }
  .figure__exif {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    font-size: 0.78rem;
    letter-spacing: 0.01em;
  }

  /* ---- Modes ---- */
  .figure--breakout {
    max-width: none;
    width: 100%;
  }
  .figure--full {
    max-width: 100vw;
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }
  .figure--full .figure__frame {
    border-radius: 0;
  }
  @media (min-width: 60rem) {
    .figure--margin {
      float: right;
      clear: right;
      width: var(--margin-track);
      margin-right: calc(-1 * (var(--margin-track) + var(--gutter)));
      margin-block: 0.4rem 1rem;
    }
    .figure--margin .figure__cap {
      font-size: 0.78rem;
    }
  }
</style>

<script>
  // Develop each photograph as it ENTERS the viewport (brief §3d), not merely on
  // load. Idempotent across view transitions; priority/hero images have no
  // [data-develop] so they appear immediately (LCP-friendly).
  function reveal(img: HTMLImageElement) {
    const frame = img.closest<HTMLElement>('.figure__frame');
    const done = () => {
      img.classList.add('is-developed');
      // Drop the LQIP backdrop once developed so it can't bleed through any
      // transparent pixels; wait for the fade so the develop effect still plays.
      if (frame && frame.style.backgroundImage) {
        const clear = () => (frame.style.backgroundImage = '');
        img.addEventListener('transitionend', clear, { once: true });
        // fallback if no transition (reduced motion / cached)
        setTimeout(clear, 800);
      }
    };
    if (img.complete && img.naturalWidth > 0) {
      requestAnimationFrame(() => requestAnimationFrame(done));
    } else {
      img.addEventListener('load', done, { once: true });
      img.addEventListener('error', done, { once: true });
    }
  }

  function developImages() {
    document.documentElement.classList.add('js');
    const imgs = Array.from(
      document.querySelectorAll<HTMLImageElement>(
        'img.figure__img[data-develop]:not([data-wired])'
      )
    );
    if (!imgs.length) return;
    if (!('IntersectionObserver' in window)) {
      imgs.forEach((img) => {
        img.dataset.wired = '1';
        reveal(img);
      });
      return;
    }
    const io = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            obs.unobserve(e.target);
            reveal(e.target as HTMLImageElement);
          }
        });
      },
      { rootMargin: '200px 0px' }
    );
    imgs.forEach((img) => {
      img.dataset.wired = '1';
      io.observe(img);
    });
  }
  developImages();
  document.addEventListener('astro:page-load', developImages);
</script>
