---
import { getImage } from 'astro:assets';
import type { ResolvedPhoto } from '../utils/series';

/*
  Gallery — a dense, uniform grid of square thumbnails (gallery-wall style).
  Thumbnails are cropped square at build; clicking opens the full image in the
  Lightbox. Sparse: no captions/EXIF in the grid itself.
*/
interface Props {
  photos: ResolvedPhoto[];
}
const { photos } = Astro.props;

const items = await Promise.all(
  photos.map(async (p) => {
    const thumb = await getImage({
      src: p.image,
      width: 700,
      height: 700,
      fit: 'cover',
      position: 'attention',
      format: 'webp',
    });
    const full = await getImage({
      src: p.image,
      width: Math.min(2000, p.image.width),
      format: 'webp',
    });
    return { p, thumb, full };
  })
);
---

<ul class="grid" data-gallery>
  {
    items.map(({ p, thumb, full }) => (
      <li class="grid__cell">
        <button
          type="button"
          class="grid__btn"
          data-full={full.src}
          data-alt={p.alt}
          data-caption={p.caption ?? ''}
        >
          <img
            src={thumb.src}
            width={thumb.attributes.width}
            height={thumb.attributes.height}
            alt={p.alt}
            loading="lazy"
            decoding="async"
          />
        </button>
      </li>
    ))
  }
</ul>

<style>
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: var(--gap);
  }
  .grid__btn {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    padding: 0;
    border: none;
    background: var(--mat);
    cursor: pointer;
    overflow: hidden;
  }
  .grid__btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.2s var(--ease);
  }
  .grid__btn:hover img {
    opacity: 0.85;
  }
  .grid__btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
