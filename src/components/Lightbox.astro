---
/*
  Lightbox — one instance per page, driven by any [data-gallery] buttons
  (brief §5). Keyboard (←/→/Esc), touch swipe, click-to-zoom, focus trap, and a
  shareable URL (#p-N). No layout shift: it's a fixed overlay. Built as a <dialog>
  for native focus handling + Esc, progressively enhanced.
*/
---

<dialog class="lb" data-lightbox aria-label="Photograph viewer">
  <div class="lb__stage" data-lb-stage>
    <img class="lb__img" data-lb-img alt="" />
  </div>

  <div class="lb__chrome">
    <p class="lb__meta">
      <span class="lb__count mono" data-lb-count></span>
      <span class="lb__caption" data-lb-caption></span>
      <span class="lb__exif mono" data-lb-exif></span>
    </p>
  </div>

  <button type="button" class="lb__btn lb__close" data-lb-close aria-label="Close (Esc)">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
  </button>
  <button type="button" class="lb__btn lb__prev" data-lb-prev aria-label="Previous (Left arrow)">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>
  </button>
  <button type="button" class="lb__btn lb__next" data-lb-next aria-label="Next (Right arrow)">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg>
  </button>
</dialog>

<style>
  .lb {
    width: 100vw;
    width: 100dvw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    background: var(--mat);
    color: #ececec;
    overflow: hidden;
  }
  .lb::backdrop {
    background: #000;
  }
  .lb:not([open]) {
    display: none;
  }

  .lb__stage {
    position: absolute;
    inset: 0 0 4.5rem 0;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 4vw, 3rem);
    touch-action: pan-y;
  }
  .lb__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius);
    cursor: zoom-in;
    transition:
      transform var(--dur) var(--ease-out),
      opacity var(--dur-fast) var(--ease-out);
    will-change: transform;
  }
  .lb__img.is-zoomed {
    cursor: zoom-out;
  }
  .lb.is-switching .lb__img {
    opacity: 0;
  }

  .lb__chrome {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--space-s) clamp(1rem, 4vw, 3rem) var(--space-m);
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
  }
  .lb__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1.2rem;
    max-width: 70ch;
  }
  .lb__count {
    color: #9a9a96;
    font-size: var(--step--1);
  }
  .lb__caption {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-0);
  }
  .lb__exif {
    width: 100%;
    color: #9a9a96;
    font-size: 0.78rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
  }

  .lb__btn {
    position: absolute;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: none;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.35);
    color: #ececec;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .lb__btn:hover {
    background: rgba(0, 0, 0, 0.6);
  }
  .lb__btn:focus-visible {
    outline: 2px solid #ececec;
    outline-offset: 2px;
  }
  .lb__close {
    top: 1rem;
    right: 1rem;
  }
  .lb__prev {
    left: 1rem;
    top: calc(50% - 4rem);
  }
  .lb__next {
    right: 1rem;
    top: calc(50% - 4rem);
  }
  @media (max-width: 34rem) {
    .lb__prev {
      left: 0.5rem;
    }
    .lb__next {
      right: 0.5rem;
    }
  }
</style>

<script>
  interface Item {
    full: string;
    alt: string;
    caption: string;
    exif: string[];
  }

  function initLightbox() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    if (!dialog || (dialog as any).__wired) return;
    (dialog as any).__wired = true;

    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-gallery] [data-index]')
    );
    if (!buttons.length) return;

    const items: Item[] = buttons.map((b) => ({
      full: b.dataset.full || '',
      alt: b.dataset.alt || '',
      caption: b.dataset.caption || '',
      exif: JSON.parse(b.dataset.exif || '[]'),
    }));

    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const countEl = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
    const capEl = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const exifEl = dialog.querySelector<HTMLElement>('[data-lb-exif]')!;
    const stage = dialog.querySelector<HTMLElement>('[data-lb-stage]')!;

    let index = 0;
    let lastFocus: HTMLElement | null = null;
    let zoomed = false;

    const render = () => {
      const it = items[index];
      dialog.classList.add('is-switching');
      const tmp = new Image();
      tmp.onload = () => dialog.classList.remove('is-switching');
      tmp.src = it.full;
      img.src = it.full;
      img.alt = it.alt;
      countEl.textContent = `${index + 1} / ${items.length}`;
      capEl.textContent = it.caption;
      exifEl.textContent = it.exif.join('  ·  ');
      resetZoom();
    };

    const resetZoom = () => {
      zoomed = false;
      img.classList.remove('is-zoomed');
      img.style.transform = '';
    };

    const setHash = () => {
      history.replaceState(null, '', `#p-${index + 1}`);
    };

    const open = (i: number, focusReturn: HTMLElement | null) => {
      index = i;
      lastFocus = focusReturn;
      render();
      if (!dialog.open) dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
      setHash();
    };

    const close = () => {
      if (dialog.open) dialog.close();
    };

    const go = (delta: number) => {
      index = (index + delta + items.length) % items.length;
      render();
      setHash();
    };

    // wire thumbnails
    buttons.forEach((b, i) =>
      b.addEventListener('click', (e) => {
        e.preventDefault();
        open(i, b);
      })
    );

    dialog.querySelector('[data-lb-close]')!.addEventListener('click', close);
    dialog
      .querySelector('[data-lb-prev]')!
      .addEventListener('click', () => go(-1));
    dialog
      .querySelector('[data-lb-next]')!
      .addEventListener('click', () => go(1));

    // click on backdrop / outside image closes; on image toggles zoom
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target === stage) close();
    });
    img.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleZoom(e);
    });

    function toggleZoom(e: MouseEvent) {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      zoomed = !zoomed;
      img.classList.toggle('is-zoomed', zoomed);
      if (zoomed && !reduce) {
        const r = img.getBoundingClientRect();
        const ox = ((e.clientX - r.left) / r.width) * 100;
        const oy = ((e.clientY - r.top) / r.height) * 100;
        img.style.transformOrigin = `${ox}% ${oy}%`;
        img.style.transform = 'scale(2.2)';
      } else {
        img.style.transform = '';
      }
    }

    // keyboard
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        go(-1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        go(1);
      }
      // Esc handled natively by <dialog>
    });

    // restore focus + scroll on close
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      history.replaceState(null, '', window.location.pathname + window.location.search);
      lastFocus?.focus();
    });

    // touch swipe
    let sx = 0,
      sy = 0,
      tracking = false;
    stage.addEventListener(
      'pointerdown',
      (e) => {
        if (zoomed) return;
        tracking = true;
        sx = e.clientX;
        sy = e.clientY;
      },
      { passive: true }
    );
    stage.addEventListener('pointerup', (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.clientX - sx;
      const dy = e.clientY - sy;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
        go(dx < 0 ? 1 : -1);
      }
    });

    // deep link: open on load if #p-N matches
    const m = window.location.hash.match(/^#p-(\d+)$/);
    if (m) {
      const i = parseInt(m[1], 10) - 1;
      if (i >= 0 && i < items.length) open(i, buttons[i]);
    }
  }

  initLightbox();
  document.addEventListener('astro:page-load', initLightbox);
</script>
