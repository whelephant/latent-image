---
/*
  Lightbox — minimal. Opens the full image over a dark backdrop; prev/next/close,
  keyboard (←/→/Esc). Driven by [data-gallery] [data-full] buttons in DOM order.
*/
---

<dialog class="lb" data-lightbox aria-label="Photograph">
  <button type="button" class="lb__close" data-lb-close aria-label="Close">✕</button>
  <button type="button" class="lb__nav lb__prev" data-lb-prev aria-label="Previous">‹</button>
  <img class="lb__img" data-lb-img alt="" />
  <button type="button" class="lb__nav lb__next" data-lb-next aria-label="Next">›</button>
  <p class="lb__cap" data-lb-cap></p>
</dialog>

<style>
  .lb {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    background: var(--mat);
  }
  .lb::backdrop {
    background: #000;
  }
  .lb:not([open]) {
    display: none;
  }
  .lb__img {
    position: absolute;
    inset: 0;
    margin: auto;
    max-width: 92vw;
    max-height: 88dvh;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .lb__cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1rem;
    text-align: center;
    color: #cfcfca;
    font-size: var(--step--1);
    padding-inline: 1rem;
  }
  .lb__close,
  .lb__nav {
    position: absolute;
    z-index: 2;
    background: none;
    border: none;
    color: #ececec;
    cursor: pointer;
    line-height: 1;
  }
  .lb__close {
    top: 1rem;
    right: 1.25rem;
    font-size: 1.6rem;
  }
  .lb__nav {
    top: 50%;
    transform: translateY(-50%);
    font-size: 2.6rem;
    padding: 0.5rem 1rem;
  }
  .lb__prev {
    left: 0.5rem;
  }
  .lb__next {
    right: 0.5rem;
  }
  .lb__close:focus-visible,
  .lb__nav:focus-visible {
    outline: 2px solid #ececec;
    outline-offset: 2px;
  }
</style>

<script>
  function initLightbox() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    if (!dialog) return;
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-gallery] [data-full]')
    );
    if (!buttons.length) return;

    const items = buttons.map((b) => ({
      full: b.dataset.full || '',
      alt: b.dataset.alt || '',
      caption: b.dataset.caption || '',
    }));
    const single = items.length < 2;

    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const cap = dialog.querySelector<HTMLElement>('[data-lb-cap]')!;
    const prev = dialog.querySelector<HTMLButtonElement>('[data-lb-prev]')!;
    const next = dialog.querySelector<HTMLButtonElement>('[data-lb-next]')!;
    if (single) {
      prev.hidden = true;
      next.hidden = true;
    }

    let i = 0;
    let last: HTMLElement | null = null;

    const render = () => {
      img.src = items[i].full;
      img.alt = items[i].alt;
      cap.textContent = items[i].caption;
      dialog.setAttribute('aria-label', items[i].alt || 'Photograph');
    };
    const open = (n: number, ret: HTMLElement) => {
      i = n;
      last = ret;
      render();
      if (!dialog.open) dialog.showModal();
    };
    const go = (d: number) => {
      if (single) return;
      i = (i + d + items.length) % items.length;
      render();
    };

    buttons.forEach((b, n) =>
      b.addEventListener('click', () => open(n, b))
    );
    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target === img) {
        // click on backdrop closes; click on image advances (or closes if single)
        if (e.target === dialog) dialog.close();
      }
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(-1);
      else if (e.key === 'ArrowRight') go(1);
    });
    dialog.addEventListener('close', () => last?.focus());
  }
  initLightbox();
</script>
