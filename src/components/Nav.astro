---
import { NAV } from '../consts';
import Wordmark from './Wordmark.astro';
import ThemeToggle from './ThemeToggle.astro';

// Mark the active section so the current area reads as "you are here".
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="nav" transition:persist="site-nav">
  <nav class="nav__inner" aria-label="Primary">
    <a class="nav__brand" href="/" aria-label="Latent Image — home">
      <Wordmark />
    </a>

    <ul class="nav__links">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav__link', { 'is-active': isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nav__actions">
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: saturate(1.1) blur(8px);
    border-bottom: var(--rule);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    max-width: 78rem;
    margin-inline: auto;
    padding: 0.85rem var(--pad-inline);
  }
  .nav__brand {
    font-size: 1.18rem;
    color: var(--ink);
    flex: 0 0 auto;
  }
  .nav__brand:hover {
    text-decoration: none;
    color: var(--ink);
  }
  .nav__links {
    list-style: none;
    padding: 0;
    display: flex;
    gap: clamp(0.9rem, 2.5vw, 1.75rem);
    margin-inline-start: auto;
  }
  .nav__link {
    color: var(--ink-soft);
    font-size: var(--step-0);
    padding-block: 0.2rem;
    border-bottom: 1.5px solid transparent;
    transition: color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .nav__link:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .nav__link.is-active {
    color: var(--ink);
    border-bottom-color: var(--safelight);
  }
  .nav__actions {
    flex: 0 0 auto;
  }

  @media (max-width: 34rem) {
    .nav__inner {
      flex-wrap: wrap;
      gap: 0.6rem var(--space-s);
    }
    .nav__links {
      order: 3;
      width: 100%;
      margin-inline-start: 0;
      justify-content: flex-start;
    }
  }
</style>
