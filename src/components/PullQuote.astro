---
/*
  PullQuote — a breakout emphasis quote for essays. Distinct from <blockquote>
  (which cites others); this lifts a line from the prose itself. Set larger,
  optionally extending into the margin.
  Usage:  <PullQuote>The line worth slowing down for.</PullQuote>
*/
interface Props {
  cite?: string;
}
const { cite } = Astro.props;
---

<aside class="pullquote breakout">
  <p>“<slot />”</p>
  {cite && <cite class="mono">— {cite}</cite>}
</aside>

<style>
  .pullquote {
    margin-block: var(--space-l);
    padding-left: var(--space-m);
    border-left: 2px solid var(--safelight);
  }
  .pullquote p {
    font-size: var(--step-2);
    line-height: 1.28;
    font-style: italic;
    color: var(--ink);
    text-wrap: balance;
    max-width: 24ch;
  }
  .pullquote cite {
    display: block;
    margin-top: 0.6rem;
    font-style: normal;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
</style>
