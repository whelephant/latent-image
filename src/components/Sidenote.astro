---
/*
  Sidenote — gwern's best idea (brief §3c, §5). On wide screens the note lives
  in the margin track beside the text; on narrow screens it collapses to a
  tap-to-expand footnote. Pure CSS (checkbox toggle) so it needs no JS and
  motion is never load-bearing. Numbers come from a CSS counter on .reading.

  Usage in MDX:  Some claim<Sidenote>the caveat</Sidenote> continues.
*/
const id = 'sn-' + Math.random().toString(36).slice(2, 9);
---

{/* input first so the visible number (label) can show its focus ring */}
<input type="checkbox" id={id} class="sn-input visually-hidden" />
<label class="sn-number" for={id} aria-label="Toggle note"></label>
<small class="sidenote"><slot /></small>

<style>
  .sn-number {
    cursor: pointer;
    user-select: none;
  }
  .sn-number::after {
    counter-increment: sidenote;
    content: counter(sidenote);
    font-family: var(--font-mono);
    font-size: 0.7em;
    vertical-align: super;
    line-height: 0;
    color: var(--safelight);
    margin-inline-start: 0.1em;
    padding-inline: 0.15em;
  }
  .sn-input:focus-visible + .sn-number::after {
    outline: var(--focus-ring);
    outline-offset: 2px;
    border-radius: 1px;
  }

  .sidenote {
    /* the note itself, set apart from prose */
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .sidenote::before {
    content: counter(sidenote);
    font-family: var(--font-mono);
    font-size: 0.7em;
    vertical-align: super;
    line-height: 0;
    color: var(--safelight);
    margin-inline-end: 0.4em;
  }

  /* ---- Wide: float into the margin track, always visible ---- */
  @media (min-width: 60rem) {
    .sidenote {
      float: right;
      clear: right;
      width: var(--margin-track);
      /* push out of the reading column into the empty right zone */
      margin-right: calc(-1 * (var(--margin-track) + var(--gutter)));
      margin-block: 0.35rem 0.9rem;
      position: relative;
    }
    /* number is just a marker; toggling is irrelevant when always shown */
    .sn-input {
      display: none;
    }
  }

  /* ---- Narrow: hide until the number is tapped ---- */
  @media (max-width: 59.99rem) {
    .sidenote {
      display: block;
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      margin: 0;
      border-left: 2px solid var(--hairline);
      padding-left: 0;
      transition: max-height var(--dur) var(--ease-out),
        opacity var(--dur) var(--ease-out), padding var(--dur) var(--ease-out),
        margin var(--dur) var(--ease-out);
    }
    .sn-input:checked ~ .sidenote {
      max-height: 40rem;
      opacity: 1;
      padding-left: 0.9rem;
      margin-block: 0.6rem;
    }
  }
</style>
