---
/*
  TableOfContents — intersection-observer driven (brief §5). Rendered as a
  compact block at the top of the article (bordered, mono title); the active
  heading is highlighted as you scroll. Takes Astro's `headings` (from
  entry.render()).
*/
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  items.length > 1 && (
    <nav class="toc" aria-label="Table of contents" data-toc>
      <p class="toc__title mono">Contents</p>
      <ol class="toc__list">
        {items.map((h) => (
          <li class:list={['toc__item', { 'toc__item--sub': h.depth === 3 }]}>
            <a href={`#${h.slug}`} class="toc__link" data-toc-link={h.slug}>
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc {
    font-size: var(--step--1);
    line-height: 1.4;
  }
  .toc__title {
    color: var(--ink-soft);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.72rem;
    margin-bottom: 0.6rem;
  }
  .toc__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border-left: var(--rule);
  }
  .toc__item {
    padding-left: 0.9rem;
  }
  .toc__item--sub {
    padding-left: 1.8rem;
  }
  .toc__link {
    color: var(--ink-soft);
    text-decoration: none;
    display: inline-block;
    transition: color var(--dur-fast) var(--ease-out);
    text-wrap: pretty;
  }
  .toc__link:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .toc__link.is-active {
    color: var(--ink);
    font-weight: 560;
  }
</style>

<script>
  // Scroll-based active tracking: the current section is the last heading whose
  // top has passed a line near the top of the viewport — so even the LAST
  // heading activates when you reach the bottom (a narrow IO band never would).
  // AbortController tears down listeners so view-transition navigations don't
  // accumulate them.
  let tocAbort: AbortController | null = null;

  function wireToc() {
    tocAbort?.abort();
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')
    );
    if (!links.length) return;
    const bySlug = new Map(links.map((l) => [l.dataset.tocLink, l]));
    const targets = links
      .map((l) => document.getElementById(l.dataset.tocLink!))
      .filter((el): el is HTMLElement => !!el);
    if (!targets.length) return;

    const ac = new AbortController();
    tocAbort = ac;

    let active: string | null = null;
    const setActive = (slug: string | null) => {
      if (slug === active) return;
      links.forEach((l) => l.classList.remove('is-active'));
      if (slug) bySlug.get(slug)?.classList.add('is-active');
      active = slug;
    };

    const OFFSET = 120;
    const update = () => {
      let current = targets[0].id;
      for (const t of targets) {
        if (t.getBoundingClientRect().top - OFFSET <= 0) current = t.id;
        else break;
      }
      // at the very bottom, force the last heading active
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
        current = targets[targets.length - 1].id;
      }
      setActive(current);
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true, signal: ac.signal });
    window.addEventListener('resize', onScroll, { passive: true, signal: ac.signal });
    update();
  }
  document.addEventListener('astro:page-load', wireToc);
</script>
