---
/*
  ThemeToggle — cycles light -> dark -> auto. The actual theme application and
  no-flash resolution live in the inline <head> script (window.__theme) in
  Base.astro; this island only reflects + cycles the stored preference.
  Re-initialises on astro:page-load so it survives view transitions.
*/
---

<button
  type="button"
  class="theme-toggle"
  aria-label="Switch colour theme"
  title="Theme"
  data-theme-toggle
>
  <span class="theme-toggle__face" data-pref="light" aria-hidden="true">
    {/* sun */}
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <circle cx="12" cy="12" r="4.2"></circle>
      <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5 5l1.8 1.8M17.2 17.2 19 19M19 5l-1.8 1.8M6.8 17.2 5 19"></path>
    </svg>
  </span>
  <span class="theme-toggle__face" data-pref="dark" aria-hidden="true">
    {/* moon */}
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 14.5A8 8 0 1 1 9.5 4a6.3 6.3 0 0 0 10.5 10.5Z"></path>
    </svg>
  </span>
  <span class="theme-toggle__face" data-pref="auto" aria-hidden="true">
    {/* auto: circle, half-filled */}
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6">
      <circle cx="12" cy="12" r="8.4"></circle>
      <path d="M12 3.6a8.4 8.4 0 0 1 0 16.8Z" fill="currentColor" stroke="none"></path>
    </svg>
  </span>
  <span class="theme-toggle__label mono" data-theme-label aria-hidden="true">auto</span>
</button>

<style>
  .theme-toggle {
    --size: 2.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
    height: var(--size);
    padding-inline: 0.55rem;
    background: transparent;
    border: var(--rule);
    border-radius: var(--radius);
    color: var(--ink-soft);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--ink-soft);
  }
  .theme-toggle__face {
    display: none;
    line-height: 0;
  }
  .theme-toggle__label {
    font-size: var(--step--1);
    letter-spacing: 0.02em;
  }
  /* Show only the face matching the current preference. */
  :global(html[data-theme-pref='light']) .theme-toggle__face[data-pref='light'],
  :global(html[data-theme-pref='dark']) .theme-toggle__face[data-pref='dark'],
  :global(html[data-theme-pref='auto']) .theme-toggle__face[data-pref='auto'],
  /* default before JS sets the attr: show auto */
  :global(html:not([data-theme-pref])) .theme-toggle__face[data-pref='auto'] {
    display: inline-flex;
  }
</style>

<script>
  // The inline head script owns window.__theme; here we just cycle + label.
  const ORDER = ['auto', 'light', 'dark'] as const;
  function label(pref: string) {
    return pref;
  }
  function wire() {
    const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (!btn || btn.dataset.wired) return;
    btn.dataset.wired = '1';
    const lbl = btn.querySelector<HTMLElement>('[data-theme-label]');
    const theme = (window as any).__theme;
    const sync = () => {
      const pref = theme?.pref ?? 'auto';
      if (lbl) lbl.textContent = label(pref);
      btn.setAttribute(
        'aria-label',
        `Theme: ${pref}. Activate to change.`
      );
    };
    sync();
    btn.addEventListener('click', () => {
      const cur = theme?.pref ?? 'auto';
      const next = ORDER[(ORDER.indexOf(cur as any) + 1) % ORDER.length];
      theme?.set(next);
      sync();
    });
  }
  wire();
  document.addEventListener('astro:page-load', wire);
</script>
