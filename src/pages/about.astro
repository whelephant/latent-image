---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
import { href } from '../utils/href';
---

<Base title="About">
  <h1 class="page-title">About</h1>
  <div class="prose">
    <p>
      {SITE.name} is a personal home for photographs and the occasional essay —
      portrait and travel work shown as series, and writing kept short and plain.
    </p>
    <p>
      Built as a static site; photographs and words live as files in a git
      repository. <a href={href('/rss.xml')}>RSS</a>.
    </p>
  </div>
</Base>

<style>
  .page-title {
    font-size: var(--step-4);
    margin-bottom: var(--space-l);
  }
  .prose p {
    margin-block: var(--space-m);
  }
  .prose a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
