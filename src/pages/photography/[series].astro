---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import Lightbox from '../../components/Lightbox.astro';
import { resolvePhotos } from '../../utils/series';

export async function getStaticPaths() {
  const all = await getCollection('series', ({ data }) => !data.draft);
  return all.map((entry) => ({ params: { series: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, description, date, place } = entry.data;
const photos = resolvePhotos(entry.id, entry.data.photos);
---

<Base wide title={title} description={description}>
  <header class="intro">
    <h1>{title}</h1>
    <p class="intro__meta">
      {date.getFullYear()}{place ? ` · ${place}` : ''} · {photos.length} photographs
    </p>
    {description && <p class="intro__desc">{description}</p>}
  </header>

  <Gallery photos={photos} />
  <Lightbox />
</Base>

<style>
  .intro {
    max-width: var(--measure);
    margin: 0 auto var(--space-l);
  }
  .intro h1 {
    font-size: var(--step-3);
  }
  .intro__meta {
    margin-top: 0.4rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .intro__desc {
    margin-top: var(--space-s);
    color: var(--ink-soft);
  }
</style>
