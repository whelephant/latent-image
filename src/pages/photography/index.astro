---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { resolveCover } from '../../utils/series';
import { href } from '../../utils/href';

const all = (await getCollection('series', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const series = await Promise.all(
  all.map(async (s) => {
    const cover = resolveCover(s.id, s.data.cover, s.data.coverAlt);
    const thumb = await getImage({
      src: cover.image,
      width: 900,
      height: 600,
      fit: 'cover',
      position: 'attention',
      format: 'webp',
    });
    return { id: s.id, data: s.data, thumb, alt: cover.alt };
  })
);
---

<Base wide title="Photography">
  <h1 class="visually-hidden">Photography</h1>
  <ul class="projects">
    {
      series.map(({ id, data, thumb, alt }) => (
        <li>
          <a class="project" href={href(`/photography/${id}`)}>
            <img
              src={thumb.src}
              width={thumb.attributes.width}
              height={thumb.attributes.height}
              alt={alt}
              loading="lazy"
            />
            <span class="project__title">{data.title}</span>
            <span class="project__meta">
              {data.date.getFullYear()}
              {data.place ? ` · ${data.place}` : ''}
            </span>
          </a>
        </li>
      ))
    }
    {series.length === 0 && <li>No series yet.</li>}
  </ul>
</Base>

<style>
  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-l) var(--space-m);
  }
  .project {
    display: block;
  }
  .project img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: var(--mat);
  }
  .project__title {
    display: block;
    margin-top: 0.6rem;
    font-weight: 600;
  }
  .project__meta {
    display: block;
    font-size: var(--step--1);
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .project:hover .project__title {
    color: var(--accent);
  }
</style>
