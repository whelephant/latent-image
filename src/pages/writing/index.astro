---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, isoDate } from '../../utils/date';
import { href } from '../../utils/href';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base title="Writing">
  <h1 class="page-title">Writing</h1>
  <ul class="list">
    {
      posts.map((post) => (
        <li class="list__item">
          <a href={href(`/writing/${post.id}`)}>
            <span class="list__title">{post.data.title}</span>
            <time class="list__date" datetime={isoDate(post.data.pubDate)}>
              {formatDate(post.data.pubDate)}
            </time>
          </a>
        </li>
      ))
    }
    {posts.length === 0 && <li>Nothing yet.</li>}
  </ul>
</Base>

<style>
  .page-title {
    font-size: var(--step-4);
    margin-bottom: var(--space-l);
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .list__item {
    border-top: var(--rule);
  }
  .list__item:last-child {
    border-bottom: var(--rule);
  }
  .list__item a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-m);
    padding-block: var(--space-m);
  }
  .list__title {
    font-size: var(--step-1);
    font-weight: 600;
  }
  .list__item a:hover .list__title {
    color: var(--accent);
  }
  .list__date {
    flex: none;
    font-size: var(--step--1);
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
</style>
